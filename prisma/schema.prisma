generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id                   String    @id @default(cuid())
  shopDomain           String    @unique
  accessToken          String
  plan                 String    @default("free")
  indexnowKey          String?
  bingWebmasterApiKey  String?
  gscCredentials       String?
  bingSearchApiKey     String?
  firecrawlApiKey      String?
  yandexWebmasterToken String?
  ga4MeasurementId     String?
  ga4ApiSecret         String?
  ga4PropertyId        String?
  ga4Credentials       String?
  llmsTxtContent       String?
  llmsTxtAutoGenerate  Boolean   @default(true)
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  googleScopes         String?
  googleEmail          String?
  bingAccessToken      String?
  bingRefreshToken     String?
  bingTokenExpiresAt   DateTime?
  bingEmail            String?
  bingAutoSetup        Boolean   @default(false)
  onboardingDismissed  Boolean   @default(false)
  lastDashboardVisit   DateTime?
  emailDigestEnabled   Boolean   @default(true)
  merchantEmail        String?
  installedAt          DateTime  @default(now())
  uninstalledAt        DateTime?

  urlSubmissions    UrlSubmission[]
  urlIndexStatuses  UrlIndexStatus[]
  visibilityQueries VisibilityQuery[]
  competitors       Competitor[]
  schemaAudits      SchemaAudit[]
  billingEvents     BillingEvent[]
  activityLogs      ActivityLog[]
  aiMentionResults  AIMentionResult[]
}

model UrlSubmission {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url          String
  status       String   @default("pending")
  responseCode Int?
  source       String
  engine       String   @default("bing")
  errorMessage String?
  submittedAt  DateTime @default(now())

  @@index([storeId, submittedAt])
  @@index([storeId, status])
}

model UrlIndexStatus {
  id              String    @id @default(cuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url             String
  bingIndexed     Boolean?
  bingLastCrawl   DateTime?
  googleIndexed   Boolean?
  googleLastCrawl DateTime?
  lastCheckedAt   DateTime?
  crawlErrors     String?

  @@unique([storeId, url])
  @@index([storeId])
}

model VisibilityQuery {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  keyword   String
  frequency String   @default("daily")
  createdAt DateTime @default(now())

  results VisibilityResult[]

  @@index([storeId])
}

model VisibilityResult {
  id                 String   @id @default(cuid())
  queryId            String
  query              VisibilityQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  rankPosition       Int?
  domain             String?
  mentionsBrand      Boolean  @default(false)
  mentionsCompetitor Boolean  @default(false)
  snippet            String?
  source             String   @default("bing")
  checkedAt          DateTime @default(now())

  @@index([queryId, checkedAt])
}

model Competitor {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  domain  String
  name    String?

  changes CompetitorChange[]

  @@unique([storeId, domain])
}

model CompetitorChange {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  changeType    String
  changeSummary String
  detectedAt    DateTime   @default(now())
}

model SchemaAudit {
  id                    String   @id @default(cuid())
  storeId               String
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url                   String
  hasProductSchema      Boolean  @default(false)
  hasReviewSchema       Boolean  @default(false)
  hasFaqSchema          Boolean  @default(false)
  hasOrganizationSchema Boolean  @default(false)
  hasBreadcrumbSchema   Boolean  @default(false)
  hasOfferSchema        Boolean  @default(false)
  missingFields         String?
  score                 Int      @default(0)
  scannedAt             DateTime @default(now())

  @@index([storeId])
}

model AIMentionResult {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  keyword              String
  mentioned            Boolean  @default(false)
  responseSnippet      String?
  competitorsMentioned String?
  citations            String?
  checkedAt            DateTime @default(now())

  @@index([storeId, checkedAt])
  @@index([storeId, keyword])
}

model AIScore {
  id             String   @id @default(cuid())
  storeId        String   @unique
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  overallScore   Int
  grade          String
  afdocsResults  String   @default("[]")
  shopifyChecks  String   @default("[]")
  categoryScores String   @default("{}")
  diagnostics    String   @default("[]")
  resolutions    String   @default("{}")
  scannedAt      DateTime @default(now())
}

model BillingEvent {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan            String
  type            String
  details         String?
  shopifyChargeId String?
  createdAt       DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}
